[TEMPLATE]
# --- Database (must match the read-only role created by db/03_roles.sql) ---
NATSQL_DB_HOST=127.0.0.1
NATSQL_DB_PORT=3307
NATSQL_DB_USER=natsql_ro
NATSQL_DB_PASSWORD=natsql_ro_pass
NATSQL_DB_NAME=demo

# --- LLM (Ollama is optional; the fallback engine is used automatically) ---
# Set NATSQL_OLLAMA_ENABLED=false to force the fallback, or true to require Ollama.
# 3b is a good CPU-friendly default; use 7b+ if you have a GPU.
NATSQL_OLLAMA_URL=http://localhost:11434
NATSQL_OLLAMA_MODEL=qwen2.5-coder:3b

# --- Safety ---
NATSQL_MAX_ROWS=100
NATSQL_QUERY_TIMEOUT_MS=5000
NATSQL_MAX_RETRIES=1
